{
  "id": "dada-v3-workflow-inbound",
  "name": "Dada v3 Workflow Inbound",
  "description": "Routes statically authorized Dada child messages by the unified v3 workflow activity fact.",
  "contracts": {"tools": ["dada_repetition_archive"]},
  "configSchema": {
    "type": "object", "additionalProperties": false,
    "required": ["agentId", "childScopeToken", "pythonBin", "runtimeRoot", "archiveRoot", "entry", "review", "dialogue"],
    "properties": {
      "agentId": {"type": "string", "const": "dada"},
      "childScopeToken": {"type": "string", "pattern": "^child_[a-f0-9]{32}$"},
      "inboundBinding": {"$ref": "#/$defs/inboundBinding"},
      "diagnostics": {"type": "object", "additionalProperties": false, "properties": {"inboundClaim": {"type": "boolean"}}},
      "pythonBin": {"type": "string", "minLength": 1}, "runtimeRoot": {"type": "string", "minLength": 1}, "archiveRoot": {"type": "string", "minLength": 1},
      "entry": {"$ref": "#/$defs/model"}, "review": {"$ref": "#/$defs/reviewModel"}, "dialogue": {"$ref": "#/$defs/dialogueModel"}, "reviewTts": {"$ref": "#/$defs/reviewTts"}
    },
    "$defs": {
      "inboundBinding": {"type": "object", "additionalProperties": false, "required": ["sessionKey", "channelId", "accountId", "conversationId"], "properties": {"sessionKey": {"type": "string", "minLength": 1}, "channelId": {"type": "string", "minLength": 1}, "accountId": {"type": "string", "minLength": 1}, "conversationId": {"type": "string", "minLength": 1}}},
      "model": {"type": "object", "additionalProperties": false, "required": ["definitionDirectory", "definitionDigest", "provider", "model", "endpoint", "apiStyle", "userAgent"], "properties": {"definitionDirectory": {"type": "string", "minLength": 1}, "definitionDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "pattern": "^https://"}, "apiStyle": {"type": "string", "enum": ["responses", "chat-completions"]}, "userAgent": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$"}}},
      "reviewModel": {"type": "object", "additionalProperties": false, "required": ["definitionDirectory", "definitionDigest", "provider", "model", "endpoint", "apiStyle", "schedulePath", "userAgent"], "properties": {"definitionDirectory": {"type": "string", "minLength": 1}, "definitionDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "pattern": "^https://"}, "apiStyle": {"type": "string", "enum": ["responses", "chat-completions"]}, "schedulePath": {"type": "string", "minLength": 1}, "userAgent": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$"}}},
      "dialogueModel": {"type": "object", "additionalProperties": false, "required": ["definitionDirectory", "definitionDigest", "provider", "model", "endpoint", "apiStyle", "userAgent", "dialogueUnitId", "unitPath", "policyPath", "reviewSchedulePath"], "properties": {"definitionDirectory": {"type": "string", "minLength": 1}, "definitionDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "pattern": "^https://"}, "apiStyle": {"type": "string", "enum": ["responses", "chat-completions"]}, "userAgent": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$"}, "dialogueUnitId": {"type": "string", "const": "grade6-english-unit-1-school-life"}, "unitPath": {"type": "string", "minLength": 1}, "policyPath": {"type": "string", "minLength": 1}, "reviewSchedulePath": {"type": "string", "minLength": 1}}},
      "reviewTts": {"oneOf": [{"$ref": "#/$defs/reviewTtsLegacy"}, {"$ref": "#/$defs/reviewTtsVolcengineSeed"}, {"$ref": "#/$defs/reviewTtsMiniMax"}]},
      "reviewTtsLegacy": {"type": "object", "additionalProperties": false, "required": ["enabled", "endpoint", "resourceId", "speaker", "timeoutSeconds", "maxTextChars", "maxAudioBytes", "retentionSeconds"], "properties": {"enabled": {"type": "boolean"}, "endpoint": {"type": "string", "pattern": "^https://"}, "resourceId": {"type": "string", "const": "seed-tts-2.0"}, "speaker": {"type": "string", "minLength": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "maxTextChars": {"type": "integer", "minimum": 1}, "maxAudioBytes": {"type": "integer", "minimum": 1}, "retentionSeconds": {"type": "integer", "minimum": 1}}},
      "reviewTtsVolcengineSeed": {"type": "object", "additionalProperties": false, "required": ["provider", "enabled", "endpoint", "resourceId", "speaker", "timeoutSeconds", "maxTextChars", "maxAudioBytes", "retentionSeconds"], "properties": {"provider": {"type": "string", "const": "volcengine_seed"}, "enabled": {"type": "boolean"}, "endpoint": {"type": "string", "pattern": "^https://"}, "resourceId": {"type": "string", "const": "seed-tts-2.0"}, "speaker": {"type": "string", "minLength": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "maxTextChars": {"type": "integer", "minimum": 1}, "maxAudioBytes": {"type": "integer", "minimum": 1}, "retentionSeconds": {"type": "integer", "minimum": 1}}},
      "reviewTtsMiniMax": {"type": "object", "additionalProperties": false, "required": ["provider", "enabled", "endpoint", "model", "voiceId", "timeoutSeconds", "maxTextChars", "maxAudioBytes", "retentionSeconds"], "properties": {"provider": {"type": "string", "const": "minimax"}, "enabled": {"type": "boolean"}, "endpoint": {"type": "string", "const": "https://api.minimaxi.com/v1/t2a_v2"}, "model": {"type": "string", "const": "speech-2.8-turbo"}, "voiceId": {"type": "string", "minLength": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "maxTextChars": {"type": "integer", "minimum": 1}, "maxAudioBytes": {"type": "integer", "minimum": 1}, "retentionSeconds": {"type": "integer", "minimum": 1}}}
    }
  }
}
